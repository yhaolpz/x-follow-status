{
  "manifest_version": 3,
  "name": "X Follow Status",
  "version": "0.8.2",
  "description": "Show follow relationships on X and translate post or reply drafts to English.",
  "host_permissions": ["https://translate.googleapis.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["relationship-parser.js", "response-matcher.js", "page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["relationship-display.js", "editor-text.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ]
}
